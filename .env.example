# Cách đăng nhập: 'email' (mặc định) hoặc 'sms'.
# Đang dùng email OTP vì chưa có nhà cung cấp SMS. Lúc cắm được SMS thì đổi biến
# này thành sms rồi deploy lại — không phải sửa code.
NEXT_PUBLIC_VBUILDING_AUTH=email

# ── Tầng dữ liệu (PostgREST trên Railway) ──
# PostgREST là service riêng, KHÔNG mở ra internet: chỉ service `v` gọi tới nó
# qua mạng nội bộ. Dựng theo railway/GD1-runbook.sh phần B.
POSTGREST_URL=http://postgrest.railway.internal:3000

# Khóa ký phiên đăng nhập. PHẢI trùng khít PGRST_JWT_SECRET của service
# PostgREST — lệch một ký tự thì mọi request đều 401 và log chỉ nói "JWT
# invalid", không nói là do lệch khóa. Tự sinh:  openssl rand -base64 48
# Đổi khóa này = đá TẤT CẢ mọi người ra khỏi phiên ngay lập tức. Đó cũng là
# cách duy nhất để thu hồi phiên khẩn cấp, nên đừng đổi vì lý do vặt.
AUTH_JWT_SECRET=

# ── Thư đăng nhập ──
# Một chuỗi cho cả cụm, không tách năm biến: một chuỗi thì hoặc đúng cả hoặc
# sai cả, còn năm biến thì có kiểu sai chỉ lộ ra vào lúc gửi thư thật.
#   smtps://user:mat-khau@smtp.gmail.com:465     (TLS ngay từ đầu — nên dùng)
#   smtp://user:mat-khau@smtp.example.com:587    (STARTTLS)
# Để trống ở máy dev thì mã đăng nhập được in ra console. Ở production thì
# thiếu biến này là ném lỗi — im lặng nuốt đi nghĩa là cư dân ngồi chờ một lá
# thư không bao giờ đến và log không nói tại sao.
SMTP_URL=
SMTP_FROM="BQL Tòa nhà <no-reply@ten-mien-cua-anh>"

# Kiểm cả chuỗi Next -> PostgREST -> Postgres -> RLS sau khi deploy:
#   POSTGREST_URL=... AUTH_JWT_SECRET=... npm run verify:http
# Chỉ đọc, chạy được trên database thật.

# ── Ảnh hỏng hóc ──
# Thư mục lưu ảnh kèm theo yêu cầu. Trên Railway PHẢI là một Volume gắn vào
# service `v`; filesystem của container là tạm, không có volume thì mọi ảnh
# biến mất ở lần deploy kế tiếp — lặng lẽ, và chỉ lộ ra lúc có người mở lại
# một yêu cầu cũ để đối chất.
ANH_DIR=/data/ticket-photos

# ── Tài khoản nhận tiền (sinh VietQR) ──
# BIN theo chuẩn NAPAS (6 chữ số), ví dụ Vietcombank 970436, Techcombank
# 970407, MB 970422. Chưa điền thì trang hóa đơn vẫn xem được, chỉ là không có
# mã QR.
VBUILDING_BANK_BIN=970436
VBUILDING_BANK_ACCOUNT=1234567890
VBUILDING_BANK_NAME=BAN QUAN LY SUNRISE RIVERSIDE

# ── Webhook ngân hàng (đối soát tiền về) ──
# Bí mật của nhà cung cấp webhook. Điền cái nào thì endpoint đó bật; để trống
# thì endpoint tương ứng TỪ CHỐI mọi request (fail closed, không phải cho qua).
#   SePay: https://<domain>/api/webhook/bank/sepay   header Authorization: Apikey <khóa>
#   Casso: https://<domain>/api/webhook/bank/casso   header Secure-Token: <khóa>
SEPAY_WEBHOOK_APIKEY=
CASSO_WEBHOOK_TOKEN=

# ── Job nền ──
# Railway không có pg_cron, nên job nền là Cron Service gọi vào
#   POST https://<domain>/api/cron/<việc>   header  x-cron-key: <khóa này>
# Để trống thì endpoint TỪ CHỐI mọi request (fail closed) — và cũng có nghĩa là
# KHÔNG có job nền nào chạy: không nhắc nợ, không leo thang ticket quá hạn,
# không thu hồi tư cách thành viên hết hạn. Tất cả hỏng lặng lẽ.
# Danh sách việc và lịch: xem đầu file cron.sql.
CRON_SECRET=

# ── Chống dò khóa ──
# Webhook tự đếm lượt SAI khóa theo IP (10 lượt / 10 phút), bộ đếm nằm trong
# RAM của tiến trình nên chạy nhiều bản sao thì ngưỡng bị nhân lên.
#
# ĐĂNG NHẬP thì KHÁC: từ khi bỏ Supabase, mọi lượt thử đều đi qua /api/auth/*
# của chính máy chủ này và đếm lượt nằm trong Postgres (auth.ma_dang_nhap), nên
# ngưỡng đúng là ngưỡng dù chạy bao nhiêu bản sao. Xem railway/03_auth.sql.
