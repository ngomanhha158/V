# Cách đăng nhập: 'email' (mặc định) hoặc 'sms'.
# Đang tạm dùng email OTP vì chưa có nhà cung cấp SMS. Lúc cắm được SMS thì
# đổi biến này thành sms rồi deploy lại — không phải sửa code.
NEXT_PUBLIC_VBUILDING_AUTH=email

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Tài khoản nhận tiền, dùng để sinh VietQR. BIN theo chuẩn NAPAS (6 chữ số),
# ví dụ Vietcombank 970436, Techcombank 970407, MB 970422.
# Chưa điền thì trang hóa đơn vẫn xem được, chỉ là không có mã QR.
VBUILDING_BANK_BIN=970436
VBUILDING_BANK_ACCOUNT=1234567890
VBUILDING_BANK_NAME=BAN QUAN LY SUNRISE RIVERSIDE

# ── Webhook ngân hàng (đối soát tiền về) ──
# Khóa service_role của Supabase. CHỈ dùng ở máy chủ — nó bỏ qua toàn bộ RLS.
# Không đặt tiền tố NEXT_PUBLIC_, không đưa vào bất kỳ file nào đi lên git.
SUPABASE_SERVICE_ROLE_KEY=

# Bí mật của nhà cung cấp webhook. Điền cái nào thì endpoint đó bật; để trống
# thì endpoint tương ứng TỪ CHỐI mọi request (fail closed, không phải cho qua).
#   SePay: https://<domain>/api/webhook/bank/sepay   header Authorization: Apikey <khóa>
#   Casso: https://<domain>/api/webhook/bank/casso   header Secure-Token: <khóa>
SEPAY_WEBHOOK_APIKEY=
CASSO_WEBHOOK_TOKEN=
